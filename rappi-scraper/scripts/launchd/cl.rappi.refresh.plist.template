<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla: `make schedule` reemplaza __PROJECT__ por la ruta de rappi-scraper y la instala.
     Corre scripts/refresh-semanal.sh: la descarga y, si rappi-ia está instalado, la capa de IA. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cl.rappi.refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT__/scripts/refresh-semanal.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <!-- Domingos 03:00. Si el equipo estaba dormido, corre al despertar; si estaba apagado, esa semana se salta. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT__/data/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/data/logs/launchd.err.log</string>
</dict>
</plist>
