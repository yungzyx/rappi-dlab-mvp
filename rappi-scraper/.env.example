# Postgres local (Homebrew, por el socket). Con `make db-docker`: postgresql://postgres:postgres@localhost:5432/rappi
# (y /rappi_test para los tests).
DATABASE_URL=postgresql:///rappi
DATABASE_URL_TEST=postgresql:///rappi_test

# Cómo se presenta el scraper ante rappi.cl (User-Agent: «<proyecto>/<versión> (+<contacto>; …)»). El proyecto es
# también el nombre con que se buscan sus reglas en robots.txt. El contacto, una URL o un correo para que Rappi sepa a
# quién escribir; vacío, el User-Agent igual dice quién descarga (y el log lo avisa).
# RAPPI_UA_PROJECT=rappi-dlab-scraper
# RAPPI_UA_CONTACT=

# Opcional: ritmo de peticiones a rappi.cl (valores por defecto)
# RAPPI_DELAY_MIN=1.5
# RAPPI_DELAY_MAX=3.0
# RAPPI_TIMEOUT=30
# RAPPI_MAX_RETRIES=3
# RAPPI_RETRY_BACKOFF=10

# Semanas que se guardan los logs de cada comando largo (data/logs/<comando>_<fecha>.log)
# LOG_RETENTION_WEEKS=8
# Cuánto espera cada sentencia de una migración por un candado de tabla antes de fallar (lock_timeout)
# MIGRATE_LOCK_TIMEOUT=10s

# Ruta de pg_dump si no está en el PATH ni en Homebrew (la usan `rappi backup` y `rappi refresh`)
# PG_DUMP=/opt/homebrew/opt/postgresql@17/bin/pg_dump

# Rutas independientes de dónde quedó el código (en un servidor las pone docker-compose; en un equipo local no hacen
# falta):
# datos descargados, registros y respaldos (por defecto rappi-scraper/data)
# RAPPI_DATA_DIR=/data
# RAPPI_ENV_FILE va en el entorno, no aquí: es el archivo que se lee en lugar de este .env (p. ej. /etc/rappi/rappi.env)
