# Se activa en el despliegue: `systemctl enable --now rappi-purge.timer` (docs/despliegue.md).
[Unit]
Description=Rappi: purga diaria (todos los días 04:00, hora de Chile)

[Timer]
OnCalendar=*-*-* 04:00 America/Santiago
# Si el servidor estaba apagado a esa hora, corre al encender.
Persistent=true

[Install]
WantedBy=timers.target
