# Configuración de la demo pública desde un Mac (copiar a ~/rappi-tunel/tunel.env, modo 600; nunca a git).
# Los valores con «$» (el hash de la puerta) van entre comillas simples.

# La copia del repo que se sirve (una copia aparte de main: `git worktree add ~/rappi-prod origin/main`).
REPO_DIR=/Users/<usuario>/rappi-prod

# Puerta de acceso de Caddy: usuario y hash de `caddy hash-password` (guardar la clave aparte, no aquí).
BASIC_AUTH_USER=rappi
BASIC_AUTH_HASH='$2a$14$...'

# Secreto de la identidad anónima de la API (`openssl rand -hex 32`).
API_SECRET=

# Procesos de la API (cada uno carga el modelo de texto, ~1,5 GB de memoria).
API_WORKERS=2

# Respaldos nocturnos de la base `rappi` que se guardan (cada uno pesa ~2 GB).
RESPALDOS_A_GUARDAR=3

# URL fija (opcional): un túnel con nombre de una cuenta de Cloudflare con dominio propio. Sin esto, túnel rápido.
#   cloudflared tunnel login && cloudflared tunnel create <nombre> && cloudflared tunnel route dns <nombre> <dominio>
# TUNNEL_NAME=<nombre>
# PUBLIC_URL=https://<dominio>
