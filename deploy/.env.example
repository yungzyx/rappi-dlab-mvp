# Archivo de entorno del servidor: se copia a /etc/rappi/rappi.env (dueño root, modo 0600), se completa y nunca se sube
# a git. docker compose lo usa dos veces, y las dos tienen que leer este mismo archivo:
#   - para armar deploy/docker-compose.yml (DOMAIN, la puerta, las URLs de cada servicio): enlazado como deploy/.env
#     (`ln -s /etc/rappi/rappi.env deploy/.env`) o con `--env-file /etc/rappi/rappi.env` en cada comando;
#   - como env_file de db, migrate, api y jobs (RAPPI_ENV_FILE, por defecto /etc/rappi/rappi.env). Cada servicio recibe
#     solo sus claves (las demás se vacían en docker-compose.yml); Caddy no lo lee.
# Cada «cambiar-esto» es un valor que decide quien despliega. Claves: `openssl rand -hex 32` (solo letras y números:
# van dentro de URLs). Un valor con «$» va entre comillas simples.
#
# Antes de desplegar, decidir:
#   - el dominio y su DNS (un registro A/AAAA hacia el servidor; Caddy pide el certificado solo);
#   - el servidor: mínimo 4 vCPU, 8 GB de RAM y 60 GB de SSD (Postgres usa 1 GB de shared_buffers; la API con el modelo, ~0,9 GB);
#   - el usuario y la clave de la puerta de acceso;
#   - las claves de la base y API_SECRET;
#   - si se despliega el panel (WITH_PANEL=1 y API_ENABLE_ANALYTICS=1) o solo la app.

# ── Sitio y puerta de acceso (Caddy) ────────────────────────────────────────────────────────────────────────────────
# Dominio público (con localhost, Caddy usa su CA interna: para probar el stack en un equipo).
DOMAIN=cambiar-esto
# Usuario de la puerta (todo el sitio: la app, /api y /panel).
BASIC_AUTH_USER=cambiar-esto
# Hash de la clave de la puerta: `docker run --rm -it caddy:2.11.7-alpine caddy hash-password` (la pide dos veces y no
# queda en el historial). Entre comillas simples (lleva «$»). La clave en claro no se guarda en ninguna parte del servidor.
BASIC_AUTH_HASH='cambiar-esto'

# ── Base de datos ───────────────────────────────────────────────────────────────────────────────────────────────────
# Superusuario de Postgres: solo la imagen de la base lo usa (crear roles y extensiones la primera vez).
POSTGRES_PASSWORD=cambiar-esto
# Nombre de la base.
POSTGRES_DB=rappi
# Dueño de las tablas: migrar, restaurar el dump y los trabajos (deploy/db/init-roles.sh lo crea con esta clave).
RAPPI_OWNER_PASSWORD=cambiar-esto
# Rol de la API: lee todo y escribe solo los datos de las personas (deploy/db/grants.sql).
RAPPI_API_PASSWORD=cambiar-esto
# La conexión de cada servicio, con las mismas claves de arriba: migrate y jobs como rappi_owner, la API como rappi_api.
DATABASE_URL_OWNER=postgresql://rappi_owner:cambiar-esto@db:5432/rappi
DATABASE_URL_API=postgresql://rappi_api:cambiar-esto@db:5432/rappi

# ── API ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Firma la sesión anónima de cada persona (X-User-Token): `openssl rand -hex 32`. Sin ella la API no arranca.
API_SECRET=cambiar-esto
# El panel (/analytics/*): 0 si solo se despliega la app; 1 con WITH_PANEL=1.
API_ENABLE_ANALYTICS=0
# Construir el panel en /panel/ (1) o no (0: /panel/ responde 404).
WITH_PANEL=0
# Procesos de la API. Conexiones a Postgres: API_WORKERS × API_POOL_MAX + 1 (migrate) + ~3 (un trabajo de jobs) + 3
# (superusuario, reservadas) deben quedar bajo max_connections=50. Con 1 × 10 + 1 + 3 + 3 = 17 sobra margen; con más
# workers, bajar API_POOL_MAX (p. ej. 3 × 10 = 30, total 37). Los cupos por IP se cuentan por proceso: con más de 1
# worker, cada uno lleva su cuenta.
API_WORKERS=1
API_POOL_MAX=10
# Tope diario de redacciones con Claude (por proceso); alcanzado, responden las plantillas.
LLM_DAILY_CALL_CAP=300
# Claude redacta las respuestas del agente; vacío: plantillas.
ANTHROPIC_API_KEY=

# ── Trabajos (solo el servicio jobs) ────────────────────────────────────────────────────────────────────────────────
# Cómo se presenta la descarga semanal ante rappi.cl (User-Agent; el proyecto es también su nombre en robots.txt). El
# contacto, una URL o un correo; vacío, el User-Agent igual dice quién descarga.
RAPPI_UA_PROJECT=rappi-dlab-scraper
RAPPI_UA_CONTACT=
# Jev (TypeSafe), opcional y fuera de línea: vacío, no se llama (docs/jev.md). La API nunca lo recibe.
TYPESAFE_API_KEY=
# Copia de los respaldos fuera del servidor (restic): el repositorio (s3:…, b2:…, sftp:…) y su clave.
RESTIC_REPOSITORY=cambiar-esto
RESTIC_PASSWORD=cambiar-esto
# Credenciales del almacenamiento de restic: solo llegan al servicio jobs (docker-compose.yml las vacía en los demás).
# Otro proveedor con otras variables: agregarlas también a x-sin-claves-de-respaldo en docker-compose.yml.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
