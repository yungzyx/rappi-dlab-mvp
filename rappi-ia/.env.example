# Postgres local: la misma base que usa rappi-scraper (Homebrew, por el socket; con `make db-docker` de
# rappi-scraper, postgresql://postgres:postgres@localhost:5432/rappi y …/rappi_ia_test)
DATABASE_URL=postgresql:///rappi
# Base de tests propia, para no pisarse con los tests del scraper (rappi_test)
DATABASE_URL_TEST=postgresql:///rappi_ia_test

# Modelo local de texto (se descarga de Hugging Face la primera vez; si lo cambias, la primera vez `make serve HF_OFFLINE=`)
# TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Commit del modelo en Hugging Face: el de por defecto va fijado en config.py; otro modelo usa su `main` salvo que se diga
# TEXT_EMBEDDING_REVISION=
# Memoria de Postgres para construir los índices HNSW (solo durante esa transacción)
# HNSW_MAINTENANCE_WORK_MEM=1GB

# Opcional: con clave, Claude redacta las respuestas del agente; sin clave, plantillas.
# ANTHROPIC_API_KEY=
# AGENT_LLM_MODEL=claude-sonnet-5
# Nombre con que el agente se presenta (por defecto, Mochi)
# AGENT_NAME=Mochi

# Opcional: con clave de TypeSafe y un piloto aprobado (eval/jev-adopcion.json), el proceso semanal usa Jev (System One)
# para etiquetar categorías nuevas y como juez de la búsqueda; sin clave o sin adopción, no se llama a nadie (docs/jev.md).
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0
# Tope de llamadas por corrida (los reintentos cuentan) y cuántas van en paralelo
# JEV_MAX_REQUESTS=3000
# JEV_PARALLEL=16
# Precio en US$ por millón de tokens de entrada, para el costo que informa el piloto
# JEV_PRICE_PER_MTOK_INPUT=0.042

# API
# Entorno: local (por defecto, la demo en este equipo) o production (un servidor tras un proxy; ver docs/despliegue.md).
# En production: sin el patrón localhost:51xx ni API_ALLOW_LAN; los orígenes (CORS y beacon de eventos) son exactamente
# los de API_CORS_ORIGINS (sin ella, ninguno); /analytics/* y /docs quedan apagados salvo que se enciendan con 1.
# API_ENV=local
# API_ENABLE_ANALYTICS=1   # por defecto 1 en local y 0 en production
# API_DOCS=1               # por defecto 1 en local y 0 en production
# Orígenes permitidos para CORS, separados por coma. Reemplazan a los de por defecto (http://localhost:5174 y :5175):
# si sigues usando esos, inclúyelos también. Localhost y 127.0.0.1 en los puertos 51xx se aceptan siempre.
# API_CORS_ORIGINS=https://demo.ejemplo.cl,http://localhost:5174,http://localhost:5175
# Registros de la API (DEBUG, INFO, WARNING, ERROR): hora, nivel, logger y request id, sin ids de personas ni query
# LOG_LEVEL=INFO
# API_REQUIRE_SEMANTIC=1   # sin la búsqueda semántica (el modelo no cargó), /health da 503 (por defecto 0)
# API_ALLOW_LAN=1 lo pone `make serve-lan`: abre CORS a la red local (sin puerta de acceso, aunque los datos de cada
# persona piden su token firmado: solo en una red de confianza)
# Tope por consulta de la API en ms (504 si se pasa): pantallas de la app y panel (/analytics/*)
# API_TIMEOUT_INTERACTIVE_MS=5000
# API_TIMEOUT_ANALYTICS_MS=30000
# Conexiones a Postgres (un pool por proceso): mínimo, máximo y segundos que un request espera una libre (luego, 503)
# API_POOL_MIN=2
# API_POOL_MAX=10
# API_POOL_TIMEOUT_S=3
# Al arrancar, leer en segundo plano los índices de la búsqueda (pg_prewarm, migración 034): la primera búsqueda de
# cada vertical no los lee del disco. Sin la extensión o sin permiso, un aviso y la API sigue igual. 0 = sin precarga
# API_PREWARM=1
# Requests a la vez por ruta cara en cada proceso; el siguiente recibe 503 con Retry-After (en /agent/ask y
# /agent/offer, después de hacer fila hasta API_CAP_WAIT_S segundos)
# API_MAX_CONCURRENT_ASK=4
# API_MAX_CONCURRENT_SEARCH=8
# API_MAX_CONCURRENT_OFFER=4
# API_MAX_CONCURRENT_ORDERS=4
# API_MAX_CONCURRENT_ANALYTICS=2
# API_CAP_WAIT_S=1.5
# Cuerpo máximo de un request en bytes (413 si se pasa)
# API_MAX_BODY_BYTES=524288
# Requests por minuto de cada IP y, de esos, escrituras: POST, PUT, PATCH y DELETE (429 si se pasa; 0 = sin tope).
# Se cuenta en memoria: vale con un solo worker.
# En local, este equipo (127.0.0.1) no tiene tope.
# API_RATE_PER_MIN=120
# API_RATE_WRITE_PER_MIN=60
# Secreto que firma la sesión anónima de cada persona (X-User-Token), de al menos 32 bytes: `openssl rand -hex 32`.
# Sin él, en local se crea una vez data/api-secret (fuera de git); en production la API no arranca sin él.
# API_SECRET=
# Personas nuevas por día que cada IP puede crear con POST /session (429 si se pasa; 0 = sin tope). En local, este equipo
# no tiene tope.
# API_NEW_USERS_PER_IP_DAY=20
# Tope diario (día de Santiago, por proceso) de redacciones con Claude; alcanzado, plantillas. 0 = nunca llama.
# LLM_DAILY_CALL_CAP=300
# `rappi-ia purge` borra a las personas del prototipo sin actividad en estos días
# PROTOTYPE_USER_RETENTION_DAYS=180
# Punto fijo de la demo (Providencia, Santiago) desde el que /catalog/home mide «Cerca de ti»
# MVP_HOME_LAT=-33.4263
# MVP_HOME_LNG=-70.6106
# Ciudad de los restaurantes de un perfil de gusto si la persona no tiene ciudad (una del scraper: «Viña del Mar»)
# PROFILE_CITY=Santiago de Chile
# Población de la que aprende el motor multivertical: synthetic (simulada, no es evidencia) o prototype. No se mezclan
# MOTOR_POBLACION=synthetic

# Arrancar la API y los comandos sin cargar modelos (tests, o un equipo sin el extra ml)
# RAPPI_IA_LIGHT=1

# Rutas independientes de dónde quedó el código (en un servidor las pone docker-compose; en un equipo local no
# hacen falta):
# cachés y reportes (por defecto rappi-ia/data)
# RAPPI_IA_DATA_DIR=/data/ia
# RAPPI_ENV_FILE va en el entorno, no aquí: es el archivo que se lee en lugar de este .env (p. ej. /etc/rappi/rappi.env)
# Solo para `rappi-ia deploy-migrate`: el rol de la API al que se le dan los permisos de deploy/db/grants.sql (en el
# servidor lo pone docker-compose)
# DB_API_ROLE=rappi_api
