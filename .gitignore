# Entorno local
.DS_Store
.venv/
# Variables de entorno (cualquier variante: .env.production, .env.staging…); solo los ejemplos se versionan
.env*
!.env.example
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Datos descargados de rappi.cl: no se versionan (tamaño y uso responsable; ver README.md#qué-es-real-y-qué-es-simulado).
# Se traspasan con un respaldo de la base (ver docs/instalacion.md).
rappi-scraper/data/
# Respaldos de la base (docs/instalacion.md): traen el catálogo descargado y los eventos; no se suben, estén donde estén
*.dump
*.sql.gz
*.backup
# Y los que quedan a medias (respaldos cortados, `.part` del scraper y `.tmp` del Mac)
*.dump.part
*.dump.tmp

# La presentación armada (make presentacion): lleva la muestra del catálogo y sus fotos, no se versiona
presentacion/dist/

# Evidencia que deja la verificación visual de los diagramas
docs/diagramas/*.visual-check.*

# Carpetas y archivos locales de herramientas de desarrollo (no se versionan; no se ignora .claude/ entero)
.superpowers/
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/

# Terraform (infra/oci): el estado y las variables locales tienen OCIDs e IPs de la cuenta.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
infra/**/*.tfvars.json
infra/**/plan.out
infra/**/*.tfplan
infra/**/ultimo-intento.log
